NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for real AI analysis and OpenAI web search.
OPENAI_API_KEY=

# Optional overrides.
OPENAI_MODEL=gpt-5.2
OPENAI_SEARCH_COUNTRY=AU
OPENAI_SEARCH_CITY=Melbourne
OPENAI_SEARCH_REGION=Victoria

# Set to true to force local fallback only.
OPENAI_DISABLE_WEB_SEARCH=false

# Share account data across desktop and mobile.
WELLGROVE_STORAGE=supabase
# Enable only to merge this machine's legacy data into the signed-in account.
WELLGROVE_MERGE_LOCAL=0
